# Monday.com personal API token
# Get it from: https://developer.monday.com/api-reference/docs/authentication
VITE_MONDAY_API_TOKEN=your_monday_api_token_here

# Admin portal login (both required to enable the admin account).
# NOTE: VITE_ vars are bundled into the client JS — this keeps creds out of git
# and rotatable, but does not hide them from the browser.
VITE_ADMIN_EMAIL=admin@millergroup.com
VITE_ADMIN_PASSWORD=change_me
